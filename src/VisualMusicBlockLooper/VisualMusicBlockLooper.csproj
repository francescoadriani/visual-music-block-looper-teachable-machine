<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VisualMusicBlockLooper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <None Update="Inference/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/suoni/*" Link="assets/suoni/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/foglio-loop-a4.svg" Link="assets/foglio-loop-a4.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/foglio-loop-a4.pdf" Link="assets/foglio-loop-a4.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/foglio-loop-32-passi-a4.svg" Link="assets/foglio-loop-32-passi-a4.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/foglio-loop-32-passi-a4.pdf" Link="assets/foglio-loop-32-passi-a4.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/modelli teachable machine/tm-my-image-model.zip"
          Link="assets/modelli teachable machine/tm-my-image-model.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
